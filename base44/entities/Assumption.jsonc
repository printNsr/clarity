{
  "name": "Assumption",
  "type": "object",
  "properties": {
    "change_id": {
      "type": "string"
    },
    "discipline": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low"
      ],
      "default": "Medium"
    }
  },
