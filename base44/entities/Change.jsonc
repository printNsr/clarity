{
  "name": "Change",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "high",
        "med",
        "low"
      ],
      "default": "med"
    },
    "needs_decision": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "unresolved",
        "resolved",
        "draft"
      ],
      "default": "draft"
    },
    "decision_owner": {
      "type": "string"
    },
    "decision_due": {
      "type": "string",
      "format": "date"
    },
    "final_decision": {
      "type": "string"
    },
    "decided_by": {
      "type": "string"
    },
    "decision_reason": {
      "type": "string"
    },
    "decision_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "title"
  ]
}